<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.project.mapper.CommentsMapper">


	<insert id="add">
		insert into
		comments(comment_no,board_no,writer,content) values(
